# Runtime
NODE_ENV=development
PORT=4000

# MongoDB connection string.
# Local docker:  mongodb://localhost:27017/lead_tracker
# Atlas:         mongodb+srv://<user>:<pass>@<cluster>/lead_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/lead_tracker

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Requests per window, per IP, for the /api/leads write endpoints
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
